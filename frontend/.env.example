# Environnement de déploiement (local, preprod, production...) : hors
# "production", le middleware pose X-Robots-Tag: noindex sur toute réponse
# (Phase 18, volet applicatif). Absent = traité comme "production", même
# défaut que config('app.env') côté backend.
APP_ENV=local

# URL de l'API Laravel consommée côté serveur (Server Components, lib/api)
API_BASE_URL=http://localhost:8000/api/v1

# Pays par défaut si le sous-domaine ne permet pas de résoudre le pays
NEXT_PUBLIC_SITE_DEFAULT_COUNTRY=fr

# Domaine racine utilisé pour extraire le sous-domaine pays (topsocietes.test en local, topsocietes.com en prod)
NEXT_PUBLIC_BASE_DOMAIN=topsocietes.test

# Tuiles OSM pour Leaflet
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Secret partagé avec le backend pour authentifier les appels à /api/revalidate (revalidateTag)
REVALIDATE_SECRET=
